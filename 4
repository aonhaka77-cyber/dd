                        error: ['bg-rose-100 text-rose-600', 'alert'],
                        notice: ['bg-indigo-100 text-indigo-600', '공지'],
                        budget: ['bg-amber-100 text-amber-700', '예산']
                    };
                    const formatTime = (value) => new Date(value).toLocaleString('ko-KR', {
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    logList.innerHTML = App.state.systemLogs.length ? '' : `
                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 text-sm font-bold text-slate-400 text-center">
                            아직 기록된 시스템 알림이 없습니다.
                        </div>
                    `;
                    App.state.systemLogs.forEach(log => {
                        const [badgeClass, badgeText] = typeStyle[log.type] || typeStyle.info;
                        const message = App.ui.escapeHTML(log.message);
                        logList.insertAdjacentHTML('beforeend', `
                            <button onclick="App.ui.toggleLogDetail(${log.id})" class="w-full text-left p-4 rounded-2xl bg-white border border-slate-100 shadow-sm active-push">
                                <div class="flex items-start justify-between gap-3">
                                    <p class="text-sm font-bold text-slate-700 leading-relaxed">${message}</p>
                                    <span class="shrink-0 px-2 py-1 rounded-full text-[10px] font-black ${badgeClass}">${badgeText}</span>
                                </div>
                                <p class="text-[10px] font-bold text-slate-400 mt-2">${formatTime(log.time)}</p>
                                ${String(App.state.openLogId) === String(log.id) ? `
                                    <div class="mt-4 pt-4 border-t border-slate-100 space-y-2">
                                        <p class="text-xs font-bold text-slate-500">상세 시간: ${new Date(log.time).toLocaleString('ko-KR')}</p>
                                        <p class="text-xs font-bold text-slate-500">알림 종류: ${badgeText}</p>
                                        ${log.meta ? `<pre class="text-[11px] leading-relaxed bg-slate-50 border border-slate-100 rounded-xl p-3 overflow-x-auto text-slate-500">${App.ui.escapeHTML(JSON.stringify(log.meta, null, 2))}</pre>` : ''}
                                    </div>
                                ` : ''}
                            </button>
                        `);
                    });

                    noticeList.innerHTML = App.state.notices.length ? '' : `
                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 text-sm font-bold text-slate-400 text-center">
                            등록된 업데이트 공지가 없습니다.
                        </div>
                    `;
                    App.state.notices.forEach(notice => {
                        const title = App.ui.escapeHTML(notice.title);
                        const body = App.ui.escapeHTML(notice.body);
                        const comments = Array.isArray(notice.comments) ? notice.comments : [];
                        noticeList.insertAdjacentHTML('beforeend', `
                            <article class="p-5 rounded-2xl bg-white border border-slate-100 shadow-sm">
                                <button onclick="App.ui.openNoticeDetail(${notice.id})" class="w-full text-left active-push">
                                    <div class="flex items-start justify-between gap-3 mb-2">
                                        <h4 class="font-black text-slate-800 break-words">${title}</h4>
                                        <span class="shrink-0 text-[10px] font-black text-indigo-400">자세히</span>
                                    </div>
                                    <p class="text-sm text-slate-500 leading-relaxed max-h-12 overflow-hidden">${body}</p>
                                    <div class="flex items-center justify-between mt-3">
                                        <p class="text-[10px] font-bold text-slate-400">${formatTime(notice.time)}</p>
                                        <p class="text-[10px] font-black text-slate-400">좋아요 ${Number(notice.likes || 0)} · 댓글 ${comments.length}</p>
                                    </div>
                                </button>
                                <div class="flex gap-2 mt-4">
                                    <button onclick="App.actions.toggleNoticeLike(${notice.id})" class="flex-1 py-2 rounded-xl bg-rose-50 text-rose-500 text-xs font-black active-push">좋아요</button>
                                    <button onclick="App.actions.removeNotice(${notice.id})" class="px-4 py-2 rounded-xl bg-slate-50 text-slate-400 text-xs font-black active-push">삭제</button>
                                </div>
                            </article>
                        `);
                    });

                    if (dot) dot.classList.toggle('hidden', App.state.systemLogs.length === 0);
                    if (App.state.selectedNoticeId) this.renderNoticeDetail();
                    lucide.createIcons();
                },

                renderChart() {
                    const ctx = document.getElementById('main-chart').getContext('2d');
                    const now = new Date();
                    const monthKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
                    const expenses = App.state.items.filter(i => i.amount < 0 && String(i.date || '').slice(0, 7) === monthKey);
                    const stats = {};
                    
                    expenses.forEach(e => {
                        const icon = e.description.split(' ')[0];
                        stats[icon] = (stats[icon] || 0) + Math.abs(e.amount);
                    });

                    const categoryNameByIcon = (icon) => {
                        const category = App.state.categories.find(cat => cat.icon === icon);
                        return category ? category.name : '기타';
                    };
                    const entries = Object.entries(stats).sort((a,b)=>b[1]-a[1]);
                    const totalExpense = expenses.reduce((sum, item) => sum + Math.abs(item.amount), 0);
                    const dayOfMonth = now.getDate();
                    const dailyAvg = dayOfMonth > 0 ? Math.round(totalExpense / dayOfMonth) : 0;
                    const top = entries[0] || ['-', 0];
                    const topName = entries.length ? categoryNameByIcon(top[0]) : '-';
                    const monthLabel = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long' }).format(now);

                    document.getElementById('stats-month-label').innerText = monthLabel;
                    document.getElementById('stats-summary').innerHTML = `
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
                            <p class="text-[10px] font-black text-slate-400 mb-1">총 지출</p>
                            <p class="text-sm sm:text-base font-black text-rose-500 tabular-nums">${totalExpense.toLocaleString()}</p>
                        </div>
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
                            <p class="text-[10px] font-black text-slate-400 mb-1">하루 평균</p>
                            <p class="text-sm sm:text-base font-black text-slate-800 tabular-nums">${dailyAvg.toLocaleString()}</p>
                        </div>
                        <div class="bg-white border border-slate-100 rounded-2xl p-4 shadow-sm">
                            <p class="text-[10px] font-black text-slate-400 mb-1">최다 지출</p>
                            <p class="text-sm sm:text-base font-black text-indigo-600 truncate">${App.ui.escapeHTML(topName)}</p>
                        </div>
                    `;

                    if (App.state.chart) App.state.chart.destroy();
                    App.state.chart = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: entries.length ? entries.map(([icon]) => `${icon} ${categoryNameByIcon(icon)}`) : ['내역 없음'],
                            datasets: [{
                                data: entries.length ? entries.map(([, val]) => val) : [1],
                                backgroundColor: entries.length ? ['#2563eb', '#f43f5e', '#10b981', '#f59e0b', '#8b5cf6', '#14b8a6', '#64748b'] : ['#e2e8f0'],
                                borderWidth: 4,
                                borderColor: '#ffffff',
                                hoverOffset: 6
                            }]
                        },
                        options: {
                            cutout: '72%',
                            plugins: {
                                legend: {
                                    display: entries.length > 0,
                                    position: 'bottom',
                                    labels: { usePointStyle: true, boxWidth: 8, font: { weight: '700' } }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: (context) => `${context.label}: ${Number(context.raw).toLocaleString()}원`
                                    }
                                }
                            }
                        }
                    });

                    const ranking = document.getElementById('ranking-list');
                    ranking.innerHTML = '';
                    if (entries.length === 0) {
                        ranking.innerHTML = `
                            <div class="bg-white border border-slate-100 rounded-3xl p-8 text-center shadow-sm">
                                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-300">
                                    <i data-lucide="chart-no-axes-column" class="w-7 h-7"></i>
                                </div>
                                <p class="font-black text-slate-700 mb-1">이번 달 지출이 없습니다</p>
                                <p class="text-sm font-bold text-slate-400">내역이 쌓이면 소비 패턴을 보여드릴게요.</p>
                            </div>
                        `;
                        lucide.createIcons();
                        return;
                    }

                    entries.forEach(([icon, val], index) => {
                        const pct = totalExpense > 0 ? Math.round((val / totalExpense) * 100) : 0;
                        const categoryName = App.ui.escapeHTML(categoryNameByIcon(icon));
                        ranking.insertAdjacentHTML('beforeend', `
                            <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm">
                                <div class="flex justify-between items-center gap-3 mb-3">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="w-10 h-10 rounded-2xl bg-slate-50 flex items-center justify-center text-xl shrink-0">${icon}</span>
                                        <div class="min-w-0">
                                            <p class="font-black text-slate-800 truncate">#${index + 1} ${categoryName}</p>
                                            <p class="text-[10px] font-bold text-slate-400">${pct}% 사용</p>
                                        </div>
                                    </div>
                                    <span class="font-black text-indigo-600 tabular-nums">${val.toLocaleString()}원</span>
                                </div>
                                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full bg-indigo-500" style="width: ${pct}%"></div>
                                </div>
                            </div>
                        `);
                    });
                },

                openBudgetModal() {
                    App.ui.closeAllModals();
                    const el = document.getElementById('budget-input');
                    if (el) el.value = App.state.budget ? String(App.state.budget).replace(/\B(?=(\d{3})+(?!\d))/g, ',') : '';
                    document.getElementById('budget-modal').classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                },

                closeBudgetModal() {
                    document.getElementById('budget-modal').classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                },

                openExportModal() {
                    App.ui.closeAllModals();
                    document.getElementById('export-modal').classList.remove('hidden');
                    document.body.classList.add('overflow-hidden');
                },

                closeExportModal() {
                    document.getElementById('export-modal').classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                },

                closeAllModals() {
                    const ids = ['input-modal','cat-modal','budget-modal','export-modal','stats-view','system-panel','notice-detail-modal'];
                    ids.forEach(id => {
                        const el = document.getElementById(id);
                        if (el && !el.classList.contains('hidden')) el.classList.add('hidden');
                    });
                    document.body.classList.remove('overflow-hidden');
                },

                formatNumberInput(el) {
                    if (!el) return;
                    const raw = String(el.value).replace(/[^0-9]/g, '');
                    if (!raw) { el.value = ''; return; }
                    el.value = parseInt(raw).toLocaleString('ko-KR');
                },

                escapeHTML(value) {
                    return String(value || '').replace(/[&<>"']/g, char => ({
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    }[char]));
                },

                showToast(message, ms = 3000, addToLog = true) {
                    if (addToLog) App.actions.addSystemLog(message, 'info');
                    const t = document.getElementById('toast');
                    t.innerText = message;
                    t.classList.remove('hidden');
                    // force reflow to allow animation
                    void t.offsetWidth;
                    t.classList.add('show');
                    clearTimeout(t._hideTimer);
                    t._hideTimer = setTimeout(() => {
                        t.classList.remove('show');
                        // hide after animation
                        setTimeout(() => t.classList.add('hidden'), 260);
                    }, ms);
                }
            }
        };

        // 앱 기동
        document.addEventListener('DOMContentLoaded', () => App.init());
    </script>
</body>
</html>
